Completion:
  HeaderInsertion: Never

CompileFlags:
  Add:
    - -DAPP_NAME="sw-render-test"
    - -I/usr/include/freetype2
    - -I/usr/include/libpng16
    - -I/usr/include/harfbuzz
    - -I/usr/include/glib-2.0
    - -I/usr/include/glib-2.0/include
    - -I/usr/include/sysprof-6

---

If:
  PathMatch: [".*\\.c"]
CompileFlags:
  Add:
    - -std=c23

---

If:
  PathMatch: [".*\\.cpp", ".*\\.hpp", ".*\\.h"]
CompileFlags:
  Add:
    - -std=c++23
